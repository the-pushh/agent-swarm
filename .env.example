# Copy to .env, fill in your key, then export it (see README).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Stage 2 research inherits OPENROUTER_MODEL unless this optional override is set.
# MVP_MODEL=z-ai/glm-5.3-flash
# Keep reasoning bounded so a tool-calling run leaves room for its actual answer.
MVP_REASONING_EFFORT=low

# Direct TypeSafe API key from https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Gmail Desktop OAuth (download client JSON from GCP; do not paste it here).
GMAIL_CLIENT_SECRET_FILE=.secrets/gmail-client.json
GMAIL_TOKEN_FILE=.secrets/gmail-token.json
# Optional: fail if OAuth connects a different account.
GMAIL_ACCOUNT=
# Scan inbox messages from the last 30 days. Empty value scans the whole inbox.
GMAIL_QUERY=newer_than:30d

# Calendar agent: separate consent/token; same Desktop OAuth client.
CALENDAR_CLIENT_SECRET_FILE=.secrets/gmail-client.json
CALENDAR_TOKEN_FILE=.secrets/calendar-token.json
CALENDAR_ACCOUNT=
CALENDAR_ID=primary
CALENDAR_BUSY_CALENDARS=
